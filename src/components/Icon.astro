---
import { ICON_PATHS, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Given a label the icon becomes meaningful content; otherwise it is hidden. */
  label?: string;
}

const { name, size = 18, class: className = '', label } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  role={label ? 'img' : 'presentation'}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
>
  {label && <title>{label}</title>}
  <path d={ICON_PATHS[name]} />
</svg>
