---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Icon from './Icon.astro';
import { formatDate, useTranslations } from '~/i18n/ui';
import { readingTime, tagSlug, type Post } from '~/lib/posts';
import type { Locale } from '~/consts';

interface Props {
  post: Post;
  lang: Locale;
  /** The first card on a listing gets a larger treatment. */
  featured?: boolean;
  showTags?: boolean;
}

const { post, lang, featured = false, showTags = true } = Astro.props;
const t = useTranslations(lang);

const href = getRelativeLocaleUrl(lang, `/blog/${post.id}`);
const minutes = readingTime(post.body);
const foreign = post.data.lang !== lang;
---

<article
  class:list={[
    'card-surface group relative overflow-hidden p-5 sm:p-6',
    'hover:border-line-strong hover:bg-card-hover',
    featured && 'sm:p-8',
  ]}
>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-ink-faint">
    <time datetime={post.data.pubDate.toISOString()} class="inline-flex items-center gap-1.5">
      <Icon name="calendar" size={12} />
      {formatDate(post.data.pubDate, lang)}
    </time>
    <span class="inline-flex items-center gap-1.5">
      <Icon name="clock" size={12} />
      {minutes} {t('blog.readingTime')}
    </span>
    {
      foreign && (
        <span
          class="rounded border border-line px-1.5 py-0.5 font-[family-name:var(--font-mono)] text-[0.65rem] tracking-wider text-brass-fg"
          title={`${t('blog.writtenIn')}: ${post.data.lang === 'zh' ? t('blog.langZh') : t('blog.langEn')}`}
        >
          {post.data.lang === 'zh' ? '中文' : 'EN'}
        </span>
      )
    }
  </div>

  <h3
    class:list={[
      'mt-3 font-semibold transition-colors duration-200 group-hover:text-beacon-fg',
      featured ? 'text-2xl sm:text-[1.75rem]' : 'text-xl',
    ]}
    lang={post.data.lang === 'zh' ? 'zh-Hans' : 'en'}
  >
    <a href={href} class="after:absolute after:inset-0 after:content-['']">
      {post.data.title}
    </a>
  </h3>

  <p
    class="mt-2.5 line-clamp-3 text-sm leading-relaxed text-ink-dim"
    lang={post.data.lang === 'zh' ? 'zh-Hans' : 'en'}
  >
    {post.data.description}
  </p>

  {
    showTags && post.data.tags.length > 0 && (
      <ul class="relative z-10 mt-4 flex flex-wrap gap-1.5">
        {post.data.tags.map((tag) => (
          <li>
            <a
              href={getRelativeLocaleUrl(lang, `/blog/tags/${tagSlug(tag)}`)}
              class="inline-block rounded-full border border-line px-2.5 py-0.5 text-xs text-ink-faint transition-colors hover:border-line-strong hover:text-beacon-fg"
            >
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <span
    class="pointer-events-none absolute inset-x-0 bottom-0 h-px origin-left scale-x-0 bg-gradient-to-r from-beacon-fg to-transparent transition-transform duration-500 ease-[var(--ease-tide)] group-hover:scale-x-100"
    aria-hidden="true"></span>
</article>
