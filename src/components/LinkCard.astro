---
import { type CollectionEntry } from 'astro:content';

interface Props {
  link: CollectionEntry<'links'>;
  lang: 'en' | 'zh';
}

const { link, lang } = Astro.props;

// A local avatar stays root-relative — resolving it against `Astro.site` would
// make the dev server fetch the image from production.
const avatar = link.data.avatar ?? null;
const isRemoteAvatar = /^https?:\/\//.test(avatar ?? '');
const host = new URL(link.data.url).host;
---

<a
  href={link.data.url}
  target="_blank"
  rel="noopener noreferrer"
  class="card-surface group flex items-center gap-4 p-4 transition-[border-color,background-color,transform] duration-300 hover:-translate-y-0.5 hover:border-line-strong hover:bg-card-hover"
>
  {
    avatar ? (
      <img
        src={avatar}
        alt=""
        width={44}
        height={44}
        loading="lazy"
        decoding="async"
        referrerpolicy={isRemoteAvatar ? 'no-referrer' : undefined}
        class="size-11 shrink-0 rounded-full border border-line bg-card object-cover"
      />
    ) : (
      <span
        class="grid size-11 shrink-0 place-items-center rounded-lg border border-accent/25 bg-accent-soft font-[family-name:var(--font-display)] text-sm font-medium text-accent"
        aria-hidden="true"
      >
        {link.data.name.slice(0, 1)}
      </span>
    )
  }

  <span class="min-w-0">
    <span class="flex items-center gap-2">
      <span class="truncate text-sm font-medium group-hover:text-accent">
        {link.data.name}
      </span>
      <span class="truncate font-[family-name:var(--font-mono)] text-xs text-ink-faint">
        {host}
      </span>
    </span>
    <span class="mt-0.5 block line-clamp-2 text-sm text-ink-dim">
      {link.data.desc[lang]}
    </span>
  </span>
</a>
