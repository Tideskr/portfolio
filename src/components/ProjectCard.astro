---
import Icon from './Icon.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { type CollectionEntry } from 'astro:content';
import type { Locale } from '~/consts';
import { useTranslations } from '~/i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Locale;
  /** See PostCard — the level depends on whether a section heading precedes it. */
  titleAs?: 'h2' | 'h3';
}

const { project, lang, titleAs: Heading = 'h3' } = Astro.props;
const t = useTranslations(lang);

const data = project.data;
const [accentA, accentB] = data.accent ?? ['#1e4fd8', '#101f42'];
---

<article
  class="card-surface group relative flex flex-col overflow-hidden p-5 transition-[border-color,background-color,transform] duration-300 hover:border-line-strong hover:bg-card-hover sm:p-6"
>
  <div class="flex items-start justify-between gap-4">
    <div
      class="grid size-11 shrink-0 place-items-center rounded-lg border border-line text-sm font-semibold font-[family-name:var(--font-display)]"
      style={{ background: `linear-gradient(135deg, color-mix(in oklab, ${accentA} 25%, transparent), color-mix(in oklab, ${accentB} 12%, transparent))` }}
      aria-hidden="true"
    >
      <span style={{ color: accentA }} class="drop-shadow-[0_1px_0_rgba(255,255,255,0.25)]">
        {data.title.en.slice(0, 1).toUpperCase()}
      </span>
    </div>

    <div class="flex shrink-0 items-center gap-2">
      {
        data.archived && (
          <span class="rounded-full border border-line px-2 py-0.5 font-[family-name:var(--font-mono)] text-[0.65rem] tracking-wider text-ink-faint">
            {t('projects.archived')}
          </span>
        )
      }
      <span class="font-[family-name:var(--font-mono)] text-xs text-ink-faint">{data.year}</span>
    </div>
  </div>

  {/* The title is localised, so it must not be pinned to a language. */}
  <Heading class="mt-4 text-lg leading-snug font-semibold">
    {data.title[lang]}
  </Heading>

  <p class="mt-2 line-clamp-4 flex-1 text-sm leading-relaxed text-ink-dim">
    {data.summary[lang]}
  </p>

  <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Stack">
    {data.stack.map((item) => (
      <li
        class="rounded-full border border-line px-2.5 py-0.5 font-[family-name:var(--font-mono)] text-[0.7rem] text-ink-faint"
        lang="en"
      >
        {item}
      </li>
    ))}
  </ul>

  <div class="mt-5 flex items-center gap-2 border-t border-line pt-4">
    {data.url && (
      <a
        href={data.url}
        target="_blank"
        rel="noopener noreferrer"
        class="link-beacon inline-flex items-center gap-1.5 text-sm font-medium text-accent"
      >
        {t('projects.visit')} <Icon name="external" size={13} />
      </a>
    )}
    {data.repo && (
      <a
        href={data.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-accent"
      >
        {t('projects.source')} <Icon name="github" size={13} />
      </a>
    )}
    {
      data.post && (
        <a
          href={getRelativeLocaleUrl(lang, `/blog/${data.post.id}`)}
          class="inline-flex items-center gap-1.5 text-sm font-medium text-accent"
        >
          {t('projects.writeup')} <Icon name="arrowRight" size={13} />
        </a>
      )
    }
  </div>
</article>
