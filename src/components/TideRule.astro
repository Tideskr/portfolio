---
/**
 * A low-amplitude wave used in place of <hr> — the tide half of the site's motif.
 * Optionally carries the compass rose as a centre glyph.
 */
import CompassRose from './CompassRose.astro';
import { TIDE_WAVE } from './waves';

interface Props {
  class?: string;
  /** Put a small compass rose in the middle of the rule. */
  glyph?: boolean;
}

const { class: className = '', glyph = false } = Astro.props;
---

<div class:list={['flex items-center gap-4 text-accent/40', className]} role="separator">
  <svg
    class="h-3 flex-1"
    viewBox="0 0 180 12"
    preserveAspectRatio="none"
    fill="none"
    aria-hidden="true"
  >
    <path d={TIDE_WAVE} stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
  </svg>

  {glyph && <CompassRose size={22} ring={false} class="shrink-0 text-accent/65" />}

  <svg
    class="h-3 flex-1"
    viewBox="0 0 180 12"
    preserveAspectRatio="none"
    fill="none"
    aria-hidden="true"
  >
    <path d={TIDE_WAVE} stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
  </svg>
</div>
