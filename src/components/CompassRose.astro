---
/**
 * The compass rose from the avatar, redrawn as vector.
 * Used as a hero watermark, a section divider glyph, the scroll-to-top button
 * and the favicon — one motif, four jobs.
 */
interface Props {
  /** Rendered size in px (square). */
  size?: number;
  class?: string;
  /** Draw the graduated outer ring and its ticks. */
  ring?: boolean;
  /** Draw the four intercardinal (NE/SE/SW/NW) points. */
  ordinals?: boolean;
  /** Cardinal letters around the ring. */
  letters?: boolean;
  title?: string;
}

const {
  size = 200,
  class: className = '',
  ring = true,
  ordinals = true,
  letters = false,
  title,
} = Astro.props;

// Ticks every 7.5° on the graduated ring, longer every 45°.
const ticks = Array.from({ length: 48 }, (_, i) => {
  const angle = i * 7.5;
  const major = i % 6 === 0;
  const mid = !major && i % 2 === 0;
  return { angle, len: major ? 9 : mid ? 5.5 : 3, w: major ? 1.6 : 1 };
});

/** Half a compass point: apex → waist → centre. */
function point(rotation: number, reach: number, waist: number) {
  return {
    rotation,
    left: `100,100 100,${100 - reach} ${100 - waist},${100 - waist}`,
    right: `100,100 100,${100 - reach} ${100 + waist},${100 - waist}`,
  };
}

const cardinals = [0, 90, 180, 270].map((r) => point(r, 88, 11));
const intercardinals = ordinals ? [45, 135, 225, 315].map((r) => point(r, 58, 7)) : [];
const letterPositions = [
  { label: 'N', x: 100, y: 12 },
  { label: 'E', x: 188, y: 100 },
  { label: 'S', x: 100, y: 188 },
  { label: 'W', x: 12, y: 100 },
];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 200 200"
  fill="none"
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  {title && <title>{title}</title>}

  {
    ring && (
      <g class="rose-ring">
        <circle cx="100" cy="100" r="95" stroke="currentColor" stroke-width="0.9" opacity="0.55" />
        <circle cx="100" cy="100" r="81" stroke="currentColor" stroke-width="0.6" opacity="0.3" />
        {ticks.map(({ angle, len, w }) => (
          <line
            x1="100"
            y1="5"
            x2="100"
            y2={5 + len}
            stroke="currentColor"
            stroke-width={w}
            opacity={w > 1 ? 0.7 : 0.35}
            transform={`rotate(${angle} 100 100)`}
          />
        ))}
      </g>
    )
  }

  <g class="rose-points">
    {
      intercardinals.map((p) => (
        <g transform={`rotate(${p.rotation} 100 100)`}>
          <polygon points={p.left} fill="currentColor" opacity="0.18" />
          <polygon points={p.right} fill="currentColor" opacity="0.42" />
        </g>
      ))
    }
    {
      cardinals.map((p) => (
        <g transform={`rotate(${p.rotation} 100 100)`}>
          <polygon points={p.left} fill="currentColor" opacity="0.3" />
          <polygon points={p.right} fill="currentColor" opacity="0.72" />
        </g>
      ))
    }
  </g>

  <circle cx="100" cy="100" r="6.5" stroke="currentColor" stroke-width="1.1" opacity="0.6" />
  <circle cx="100" cy="100" r="1.8" fill="currentColor" opacity="0.9" />

  {
    letters && (
      <g
        font-family="var(--font-mono)"
        font-size="11"
        fill="currentColor"
        opacity="0.6"
        text-anchor="middle"
        dominant-baseline="middle"
      >
        {letterPositions.map((l) => (
          <text x={l.x} y={l.y}>
            {l.label}
          </text>
        ))}
      </g>
    )
  }
</svg>
