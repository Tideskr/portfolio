---
import { render } from 'astro:content';
import Post from '~/layouts/Post.astro';
import { postPaths, type Post as PostEntry } from '~/lib/posts';

export const getStaticPaths = postPaths;

interface Props {
  post: PostEntry;
  newer?: PostEntry;
  older?: PostEntry;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<Post post={post} lang="en" newer={newer} older={older}>
  <Content />
</Post>
