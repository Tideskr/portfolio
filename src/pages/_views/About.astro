---
/**
 * About. Unlike blog posts, this page *is* chrome — it gets a real translation
 * rather than a language badge. The prose lives here instead of in i18n/ui.ts
 * because that dictionary is for short strings reused across pages, and
 * paragraphs there would drown the keys that are.
 */
import { Image } from 'astro:assets';
import CompassRose from '~/components/CompassRose.astro';
import Icon from '~/components/Icon.astro';
import TideRule from '~/components/TideRule.astro';
import Base from '~/layouts/Base.astro';
import avatar from '~/assets/avatar.png';
import { SITE, SOCIALS, type Locale } from '~/consts';
import { useTranslations } from '~/i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  en: {
    lede: 'Skr is short for seeker. I build small software, care about the boring details, and write about what I learn along the way.',
    body: [
      'Most of my work happens below the surface: build pipelines, routing, data formats, and the budget a page has for loading. Nobody demos these parts, but they shape whether a product feels dependable.',
      'I prefer tools with a clear job, formats that remain readable years later, and interfaces that hold up on a slow connection. I am less interested in adding features than in removing the reasons a feature needs explaining.',
      'Outside work, I read, take notes, and occasionally make things that have nothing to do with software. That habit usually improves the software.',
    ],
    nowTitle: 'What I am working on',
    now: [
      'Keeping this site small enough to understand in one sitting.',
      'A CLI that gives a repository a useful map: entry points, active files, and ownership.',
      'Writing about the trade-offs behind tools I use and build.',
    ],
    colophonTitle: 'About this site',
    colophon:
      'The site is statically generated with Astro. Tailwind supplies the design tokens; there is no client framework. Fraunces and Inter handle Latin text, while CJK text uses the reader’s installed fonts. Most pages ship no JavaScript; theme switching, the mobile menu, and a few small behaviors are the exceptions. Everything is kept in the repository and deployed by CI to a small server behind nginx.',
    contactTitle: 'Get in touch',
    contactBody: 'Email is the reliable way to reach me. The other links are places I occasionally post.',
  },
  zh: {
    lede: 'Skr 是 seeker 的缩写。我做小型软件，认真对待那些不显眼的细节，也把一路上学到的东西写下来。',
    body: [
      '我大多数时间都在处理不太适合拿来演示的部分：构建流程、路由、数据格式，以及页面加载要花多少成本。这些东西藏在表面之下，却决定了一个产品是否可靠。',
      '我偏爱职责清楚的工具、过几年仍然读得懂的格式，以及网络很慢时依旧好用的界面。比起不断增加功能，我更在意删掉那些让功能必须被解释的原因。',
      '不写代码的时候，我会读书、记笔记，也会做一些和软件无关的东西。很多时候，后者反而会让前者做得更好。',
    ],
    nowTitle: '最近在做',
    now: [
      '把这个站点控制在一眼能看懂的规模。',
      '做一个给仓库画出实用地图的命令行工具：入口、活跃文件和维护关系。',
      '写下我使用和构建工具时遇到的取舍。',
    ],
    colophonTitle: '关于本站',
    colophon:
      '本站使用 Astro 输出静态页面，Tailwind 负责设计令牌，没有引入客户端框架。西文使用 Fraunces 和 Inter，中文使用读者设备已有的字体。大多数页面不发送 JavaScript，主题切换、移动端菜单和少数交互是例外。所有内容都保存在仓库里，再由 CI 部署到 nginx 后面的一台小服务器上。',
    contactTitle: '联系我',
    contactBody: '邮件最可靠，我通常都会回复。其他链接是我偶尔发东西的地方。',
  },
}[lang];

const socials = SOCIALS.filter((s) => s.id !== 'rss');
---

<Base title={t('about.title')} description={t('about.subtitle')} lang={lang}>
  <div class="page">
    <header class="flex flex-col gap-8 sm:flex-row sm:items-center">
      <Image
        src={avatar}
        alt={lang === 'zh' ? 'TideSkr 的头像' : "TideSkr's avatar"}
        width={224}
        height={224}
        widths={[112, 160, 224]}
        sizes="7rem"
        class="size-28 shrink-0 rounded-full border border-line object-cover shadow-[var(--shadow-lift)]"
      />

      <div>
        <p class="eyebrow">{t('nav.about')}</p>

        <h1 class="mt-4 font-[family-name:var(--font-display)] text-3xl font-semibold sm:text-4xl">
          {SITE.author}
        </h1>

        <p class="mt-3 max-w-prose text-lg leading-relaxed text-ink-dim text-pretty">
          {copy.lede}
        </p>
      </div>
    </header>

    <TideRule class="mt-12" glyph />

    <div class="mt-12 max-w-prose space-y-5 leading-relaxed text-ink-dim">
      {copy.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <section class="mt-16">
      <h2 class="font-[family-name:var(--font-display)] text-xl font-semibold">
        {copy.nowTitle}
      </h2>

      <ul class="mt-5 max-w-prose space-y-3">
        {
          copy.now.map((item) => (
            <li class="flex gap-3 text-ink-dim">
              <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-beacon-fg" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-16">
      <h2 class="font-[family-name:var(--font-display)] text-xl font-semibold">
        {copy.contactTitle}
      </h2>

      <p class="mt-3 max-w-prose text-ink-dim">{copy.contactBody}</p>

      <ul class="mt-6 flex flex-wrap gap-2.5">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel={social.href.startsWith('http') ? 'me noopener noreferrer' : 'me'}
                class="card-surface inline-flex items-center gap-2 px-3.5 py-2 text-sm transition-[border-color,color] hover:border-line-strong hover:text-beacon-fg"
              >
                <Icon name={social.icon} size={15} />
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="card-surface mt-16 p-6 sm:p-8">
      <h2 class="font-[family-name:var(--font-display)] text-lg font-semibold text-brass-fg">
        {copy.colophonTitle}
      </h2>

      <p class="mt-3 max-w-prose text-sm leading-relaxed text-ink-dim">{copy.colophon}</p>
    </section>

    <div class="mt-20 flex justify-center">
      <CompassRose size={30} ring={false} class="text-brass-fg/40" />
    </div>
  </div>
</Base>
