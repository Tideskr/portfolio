---
/**
 * About. Unlike blog posts, this page *is* chrome — it gets a real translation
 * rather than a language badge. The prose lives here instead of in i18n/ui.ts
 * because that dictionary is for short strings reused across pages, and
 * paragraphs there would drown the keys that are.
 */
import { Image } from 'astro:assets';
import CompassRose from '~/components/CompassRose.astro';
import Icon from '~/components/Icon.astro';
import TideRule from '~/components/TideRule.astro';
import Base from '~/layouts/Base.astro';
import avatar from '~/assets/avatar.png';
import { SITE, SOCIALS, type Locale } from '~/consts';
import { useTranslations } from '~/i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  en: {
    lede: 'My interests run from formulas to sound and the written page, then back to everyday life. This site keeps a record of where they sometimes meet.',
    body: [
      'Mathematics and physics draw my attention to structure, while computing turns some of those ideas into things that can run. Piano and quiet music offer another kind of order; literature, philosophy, and the social sciences bring attention back to particular people and the lives they share.',
      'These interests do not always need to produce a result. Sometimes they become a project, sometimes a few lines of writing, and sometimes simply another way to look at an ordinary question.',
    ],
    nowTitle: 'Currently',
    now: [
      'Keeping this site light, readable, and easy to tend.',
      'Working on a small map for unfamiliar codebases.',
      'Reading, with some time kept for piano and quiet music.',
    ],
    colophonTitle: 'This site',
    colophon:
      'Astro generates the pages. Most of them work without JavaScript; the theme switch and menu are the main exceptions. The source and writing live together in one repository, and deployment produces a set of static files.',
    contactTitle: 'Contact',
    contactBody: 'Email is read carefully. Replies may take a little time.',
  },
  zh: {
    lede: '兴趣从公式延伸到声音与书页，也落回日常。这里收着它们偶尔相遇的地方。',
    body: [
      '数学与物理让我留意结构，计算机把其中一些想法变成可以运行的东西。钢琴和轻音乐带来另一种秩序；文学、哲学与社科，则把目光放回具体的人与生活。',
      '这些兴趣并不总要得到结果。它们有时成为一个项目，有时只留下几行文字，也可能只是让一个普通问题多出另一种看法。',
    ],
    nowTitle: '近来',
    now: [
      '继续整理本站，让它轻一点，也更容易照看。',
      '为陌生的代码仓库做一张小地图。',
      '读书，也留一些时间给钢琴和轻音乐。',
    ],
    colophonTitle: '本站',
    colophon:
      '页面由 Astro 静态生成。除主题切换和菜单外，大多不需要 JavaScript。文字与源代码放在同一个仓库，部署时再输出为静态文件。',
    contactTitle: '联系',
    contactBody: '邮件都会认真读，回复有时会慢一些。',
  },
}[lang];

const socials = SOCIALS.filter((s) => s.id !== 'rss');
---

<Base title={t('about.title')} description={t('about.subtitle')} lang={lang}>
  <div class="page">
    <header class="flex flex-col gap-8 sm:flex-row sm:items-center">
      <Image
        src={avatar}
        alt={lang === 'zh' ? 'Skr 的头像' : "Skr's avatar"}
        width={224}
        height={224}
        widths={[112, 160, 224]}
        sizes="7rem"
        class="size-28 shrink-0 rounded-full border border-line object-cover shadow-[var(--shadow-lift)]"
      />

      <div>
        <p class="eyebrow">{t('nav.about')}</p>

        <h1 class="font-editorial mt-4 text-3xl sm:text-4xl" lang="en">
          {SITE.author}
        </h1>

        <p class="mt-3 max-w-prose text-lg leading-relaxed text-ink-dim text-pretty">
          {copy.lede}
        </p>
      </div>
    </header>

    <TideRule class="mt-12" glyph />

    <div class="mt-12 max-w-prose space-y-5 leading-relaxed text-ink-dim">
      {copy.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <section class="mt-16">
      <h2 class="font-editorial text-xl font-medium">
        {copy.nowTitle}
      </h2>

      <ul class="mt-5 max-w-prose space-y-3">
        {
          copy.now.map((item) => (
            <li class="flex gap-3 text-ink-dim">
              <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-16">
      <h2 class="font-editorial text-xl font-medium">
        {copy.contactTitle}
      </h2>

      <p class="mt-3 max-w-prose text-ink-dim">{copy.contactBody}</p>

      <ul class="mt-6 flex flex-wrap gap-2.5">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel={social.href.startsWith('http') ? 'me noopener noreferrer' : 'me'}
                class="card-surface inline-flex items-center gap-2 px-3.5 py-2 text-sm transition-[border-color,color] hover:border-line-strong hover:text-accent"
              >
                <Icon name={social.icon} size={15} />
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="card-surface mt-16 p-6 sm:p-8">
      <h2 class="font-editorial text-lg font-medium text-accent">
        {copy.colophonTitle}
      </h2>

      <p class="mt-3 max-w-prose text-sm leading-relaxed text-ink-dim">{copy.colophon}</p>
    </section>

    <div class="mt-20 flex justify-center">
      <CompassRose size={30} ring={false} class="text-accent/40" />
    </div>
  </div>
</Base>
