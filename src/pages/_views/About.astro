---
/**
 * About. Unlike blog posts, this page *is* chrome — it gets a real translation
 * rather than a language badge. The prose lives here instead of in i18n/ui.ts
 * because that dictionary is for short strings reused across pages, and
 * paragraphs there would drown the keys that are.
 */
import { Image } from 'astro:assets';
import CompassRose from '~/components/CompassRose.astro';
import Icon from '~/components/Icon.astro';
import TideRule from '~/components/TideRule.astro';
import Base from '~/layouts/Base.astro';
import avatar from '~/assets/avatar.png';
import { SITE, SOCIALS, type Locale } from '~/consts';
import { useTranslations } from '~/i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  en: {
    lede: 'Skr comes from seeker. This is a place for useful tools, unfinished thoughts, and the occasional note on ordinary life.',
    body: [
      'Good work rarely announces itself. A page loads without fuss. A file still opens years later. A tool knows where its job ends. These small forms of care make a thing worth keeping.',
      'Not every idea needs to become a project. Some are better kept as a note; some projects have done enough and can be left alone. The point is not to fill the shelf, but to keep what remains honest and useful.',
      'Time away from a screen matters too. Reading, walking, and repairing ordinary things restore a sense of scale that software can easily lose.',
    ],
    nowTitle: 'Currently',
    now: [
      'Keeping this site light, readable, and easy to tend.',
      'Working on a small map for unfamiliar codebases.',
      'Reading about cities, craft, and the shape of everyday routines.',
    ],
    colophonTitle: 'This site',
    colophon:
      'Astro generates the pages. Most of them work without JavaScript; the theme switch and menu are the main exceptions. The source and writing live together in one repository, and deployment produces a set of static files.',
    contactTitle: 'Contact',
    contactBody: 'Email is read carefully. Replies may take a little time.',
  },
  zh: {
    lede: 'Skr 取自 seeker。这里放着一些实用的小工具、尚未定形的想法，以及偶尔写下的日常。',
    body: [
      '好东西通常不急着证明自己。页面安静地打开，文件多年后仍能读取，工具也知道该在哪里停下。真正让人愿意久用的，往往正是这些小事。',
      '不是每个念头都要变成项目。有些适合写成几行笔记，有些做到这里已经足够。架子不必摆满，留下来的东西诚实、好用就好。',
      '离开屏幕的时间也很重要。读书、散步，或修理手边的旧东西，会把容易丢失的尺度慢慢带回来。',
    ],
    nowTitle: '近来',
    now: [
      '继续整理本站，让它轻一点，也更容易照看。',
      '为陌生的代码仓库做一张小地图。',
      '读一些关于城市、手艺和日常生活的书。',
    ],
    colophonTitle: '本站',
    colophon:
      '页面由 Astro 静态生成。除主题切换和菜单外，大多不需要 JavaScript。文字与源代码放在同一个仓库，部署时再输出为静态文件。',
    contactTitle: '联系',
    contactBody: '邮件都会认真读，回复有时会慢一些。',
  },
}[lang];

const socials = SOCIALS.filter((s) => s.id !== 'rss');
---

<Base title={t('about.title')} description={t('about.subtitle')} lang={lang}>
  <div class="page">
    <header class="flex flex-col gap-8 sm:flex-row sm:items-center">
      <Image
        src={avatar}
        alt={lang === 'zh' ? 'TideSkr 的头像' : "TideSkr's avatar"}
        width={224}
        height={224}
        widths={[112, 160, 224]}
        sizes="7rem"
        class="size-28 shrink-0 rounded-full border border-line object-cover shadow-[var(--shadow-lift)]"
      />

      <div>
        <p class="eyebrow">{t('nav.about')}</p>

        <h1 class="mt-4 font-[family-name:var(--font-display)] text-3xl font-semibold sm:text-4xl">
          {SITE.author}
        </h1>

        <p class="mt-3 max-w-prose text-lg leading-relaxed text-ink-dim text-pretty">
          {copy.lede}
        </p>
      </div>
    </header>

    <TideRule class="mt-12" glyph />

    <div class="mt-12 max-w-prose space-y-5 leading-relaxed text-ink-dim">
      {copy.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <section class="mt-16">
      <h2 class="font-[family-name:var(--font-display)] text-xl font-semibold">
        {copy.nowTitle}
      </h2>

      <ul class="mt-5 max-w-prose space-y-3">
        {
          copy.now.map((item) => (
            <li class="flex gap-3 text-ink-dim">
              <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-beacon-fg" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-16">
      <h2 class="font-[family-name:var(--font-display)] text-xl font-semibold">
        {copy.contactTitle}
      </h2>

      <p class="mt-3 max-w-prose text-ink-dim">{copy.contactBody}</p>

      <ul class="mt-6 flex flex-wrap gap-2.5">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel={social.href.startsWith('http') ? 'me noopener noreferrer' : 'me'}
                class="card-surface inline-flex items-center gap-2 px-3.5 py-2 text-sm transition-[border-color,color] hover:border-line-strong hover:text-beacon-fg"
              >
                <Icon name={social.icon} size={15} />
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="card-surface mt-16 p-6 sm:p-8">
      <h2 class="font-[family-name:var(--font-display)] text-lg font-semibold text-brass-fg">
        {copy.colophonTitle}
      </h2>

      <p class="mt-3 max-w-prose text-sm leading-relaxed text-ink-dim">{copy.colophon}</p>
    </section>

    <div class="mt-20 flex justify-center">
      <CompassRose size={30} ring={false} class="text-brass-fg/40" />
    </div>
  </div>
</Base>
