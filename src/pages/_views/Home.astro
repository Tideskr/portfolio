---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import avatar from '~/assets/avatar.png';
import CompassRose from '~/components/CompassRose.astro';
import Icon from '~/components/Icon.astro';
import PostCard from '~/components/PostCard.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import Base from '~/layouts/Base.astro';
import { SITE, SOCIALS, type Locale } from '~/consts';
import { useTranslations } from '~/i18n/ui';
import { getPosts } from '~/lib/posts';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured && !p.data.archived)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 2);

const posts = (await getPosts()).slice(0, 3);

// rss.xml sits at the site root and is not localised.
const socials = SOCIALS.map((s) => ({
  ...s,
  href: s.href.startsWith('/') && s.href !== '/rss.xml' ? getRelativeLocaleUrl(lang, s.href) : s.href,
}));

---

<Base title={SITE.author} description={t('home.tagline')} lang={lang} bleed>
  {/* ── Horizon hero ────────────────────────────────────────────────── */}
  <section
    class="relative flex min-h-[calc(100svh-11rem)] flex-col overflow-hidden md:min-h-[calc(100svh-13rem)]"
  >
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-[linear-gradient(180deg,var(--canvas)_0%,var(--canvas-2)_70%,color-mix(in_oklab,var(--color-tide)_26%,var(--canvas-2))_100%)]"
    >
    </div>

    <div aria-hidden="true" class="starfield"></div>

    <CompassRose
      size={560}
      letters
      class="pointer-events-none absolute top-1/2 -right-60 -translate-y-1/2 text-accent opacity-[0.07] select-none md:-right-36"
    />

    <div class="page relative flex flex-1 items-center py-8 sm:py-12 md:py-16">
      <div
        class="grid w-full items-center gap-8 sm:gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:gap-16"
      >
        <div class="rise max-w-xl">
          <p class="eyebrow">{t('home.kicker')}</p>

          <h1
            class="font-editorial mt-5 text-[2.35rem] leading-[1.14] text-pretty sm:text-5xl md:text-[3.25rem]"
            lang="en"
          >
            {t('home.role')}
          </h1>

          <p class="mt-4 text-lg leading-relaxed text-ink-dim text-pretty">{t('home.tagline')}</p>

          <blockquote
            class="mt-5 border-l border-accent/45 pl-4 text-sm leading-relaxed text-ink-faint"
          >
            <p>{t('home.intro')}</p>
            <cite class="mt-2 block text-xs not-italic text-ink-faint">
              {t('home.quoteSource')}
            </cite>
          </blockquote>

          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href={getRelativeLocaleUrl(lang, '/blog')}
              class="inline-flex items-center gap-2 rounded-lg border border-ink bg-ink px-5 py-2.5 text-sm font-medium text-canvas transition-opacity duration-200 hover:opacity-85"
            >
              {t('home.cta.read')}
              <Icon name="arrowRight" size={14} />
            </a>

            <a
              href={getRelativeLocaleUrl(lang, '/projects')}
              class="link-accent inline-flex items-center gap-2 px-1 py-2.5 text-sm font-medium text-ink-dim"
            >
              {t('home.cta.work')}
            </a>
          </div>
        </div>

        <div class="rise relative mx-auto md:mx-0">
          <Image
            src={avatar}
            alt={
              lang === 'zh'
                ? 'Skr 的头像：暮色海边，一位戴着罗盘耳饰的蓝发女孩望向远方'
                : "Skr's avatar: a blue-haired girl with a compass earring looking over the sea at dusk"
            }
            width={576}
            height={576}
            widths={[144, 192, 256, 512]}
            sizes="(min-width: 768px) 16rem, (min-width: 640px) 12rem, 9rem"
            loading="eager"
            fetchpriority="high"
            class="relative size-36 rounded-full border border-line object-cover shadow-[var(--shadow-lift)] sm:size-48 md:size-64"
          />

          <span
            class="absolute right-0 bottom-0 grid size-10 place-items-center rounded-full border border-line bg-card text-accent shadow-[var(--shadow-lift)]"
            aria-hidden="true"
          >
            <CompassRose size={26} ring={false} />
          </span>
        </div>
      </div>
    </div>

    <div
      aria-hidden="true"
      class="absolute inset-x-0 bottom-0 h-px bg-accent/40"
    >
    </div>
  </section>

  {/* ── Selected work ───────────────────────────────────────────────── */}
  <section class="page mt-16 md:mt-20">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
      <div>
        <p class="eyebrow">{t('home.eyebrowWork')}</p>
        <h2
          class="font-editorial mt-3 text-2xl sm:text-3xl"
        >
          {t('home.featured')}
        </h2>
      </div>

      <a
        href={getRelativeLocaleUrl(lang, '/projects')}
        class="link-accent inline-flex items-center gap-1.5 pb-0.5 text-sm font-medium text-accent"
      >
        {t('home.viewAllProjects')}
        <Icon name="arrowRight" size={14} />
      </a>
    </div>

    {
      projects.length > 0 ? (
        <div class="mt-8 grid gap-5 md:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard project={project} lang={lang} />
          ))}
        </div>
      ) : (
        <p class="mt-8 text-sm text-ink-faint">{t('projects.empty')}</p>
      )
    }
  </section>

  {/* ── Recent writing ──────────────────────────────────────────────── */}
  <section class="page mt-16 md:mt-20">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
      <div>
        <p class="eyebrow">{t('home.eyebrowLog')}</p>
        <h2
          class="font-editorial mt-3 text-2xl sm:text-3xl"
        >
          {t('home.latest')}
        </h2>
      </div>

      <a
        href={getRelativeLocaleUrl(lang, '/blog')}
        class="link-accent inline-flex items-center gap-1.5 pb-0.5 text-sm font-medium text-accent"
      >
        {t('home.viewAll')}
        <Icon name="arrowRight" size={14} />
      </a>
    </div>

    {
      posts.length > 0 ? (
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} lang={lang} showTags={false} />
          ))}
        </div>
      ) : (
        <p class="mt-8 text-sm text-ink-faint">{t('blog.empty')}</p>
      )
    }
  </section>

  {/* ── Elsewhere ───────────────────────────────────────────────────── */}
  <section class="page mt-16 md:mt-20">
    <p class="eyebrow">{t('home.elsewhere')}</p>

    <ul class="mt-6 flex flex-wrap gap-3">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.href}
              rel={s.href.startsWith('http') ? 'me noopener' : undefined}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              class="card-surface inline-flex items-center gap-2.5 px-4 py-2 text-sm text-ink-dim transition-[border-color,color] duration-200 hover:border-line-strong hover:text-accent"
            >
              <Icon name={s.icon} size={16} />
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
