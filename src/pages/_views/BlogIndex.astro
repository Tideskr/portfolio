---
/**
 * The post listing. Shared by /blog and the tag pages — both show every post
 * regardless of the language it was written in, with a badge on the ones that
 * do not match the reader's chrome.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import Icon from '~/components/Icon.astro';
import PostCard from '~/components/PostCard.astro';
import Base from '~/layouts/Base.astro';
import type { Locale } from '~/consts';
import { useTranslations } from '~/i18n/ui';
import { tagHref, type Post } from '~/lib/posts';

interface Props {
  lang: Locale;
  posts: Post[];
  tags: { tag: string; count: number }[];
  /** Set on a tag page; the heading and title change accordingly. */
  activeTag?: string;
}

const { lang, posts, tags, activeTag } = Astro.props;
const t = useTranslations(lang);

const tagTitle = activeTag
  ? lang === 'zh'
    ? `标签：${activeTag}`
    : `${t('blog.taggedWith')}: ${activeTag}`
  : undefined;
const title = tagTitle ?? t('blog.title');
const count =
  lang === 'zh'
    ? `共 ${posts.length} ${posts.length === 1 ? t('blog.postCountOne') : t('blog.postCount')}`
    : `${posts.length} ${posts.length === 1 ? t('blog.postCountOne') : t('blog.postCount')}`;
---

<Base title={title} description={tagTitle ?? t('blog.subtitle')} lang={lang}>
  <div class="page">
    <header>
      <p class="eyebrow">{t('blog.title')}</p>

      <h1
        class="font-editorial mt-4 text-3xl sm:text-4xl"
      >
        {title}
      </h1>

      <p class="mt-3 max-w-prose text-ink-dim">{t('blog.subtitle')}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-ink-faint">
        <span>{count}</span>

        <a
          href="/rss.xml"
          class="link-accent inline-flex items-center gap-1.5"
        >
          <Icon name="rss" size={12} />
          {t('footer.rss')}
        </a>
      </div>
    </header>

    {
      tags.length > 0 && (
        <nav class="mt-8 flex flex-wrap items-center gap-2" aria-label={t('blog.allTags')}>
          <a
            href={getRelativeLocaleUrl(lang, '/blog')}
            aria-current={activeTag ? undefined : 'page'}
            class:list={[
              'rounded-md border px-3 py-1 text-xs transition-colors',
              activeTag
                ? 'border-line text-ink-faint hover:border-line-strong hover:text-ink-dim'
                : 'border-accent/50 text-accent',
            ]}
          >
            {t('blog.allTags')}
          </a>

          {tags.map(({ tag, count: n }) => (
            <a
              href={getRelativeLocaleUrl(lang, `/blog/tags/${tagHref(tag)}`)}
              aria-current={tag === activeTag ? 'page' : undefined}
              class:list={[
                'rounded-md border px-3 py-1 text-xs transition-colors',
                tag === activeTag
                  ? 'border-accent/50 text-accent'
                  : 'border-line text-ink-faint hover:border-line-strong hover:text-ink-dim',
              ]}
            >
              {tag}
              <span class="ml-1.5 font-[family-name:var(--font-mono)] opacity-60">{n}</span>
            </a>
          ))}
        </nav>
      )
    }

    {
      posts.length > 0 ? (
        <div class="mt-10 grid gap-5 sm:grid-cols-2">
          {posts.map((post, i) => (
            <div class="grid" data-reveal style={`--i: ${i % 2}`}>
              <PostCard post={post} lang={lang} titleAs="h2" />
            </div>
          ))}
        </div>
      ) : (
        <p class="mt-12 text-ink-faint">{t('blog.empty')}</p>
      )
    }
  </div>
</Base>
